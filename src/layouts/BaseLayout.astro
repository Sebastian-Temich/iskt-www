---
import '../styles/global.css';
import Seo from '../components/layout/Seo.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SkipLink from '../components/layout/SkipLink.astro';

interface Props {
  /**
   * Tytuł i opis tylko dla stron bez wpisu w src/content/seo.ts (np. 404); strony z wpisem
   * dostają meta z seo.ts, wybrane po ścieżce przez `Seo`.
   */
  title?: string;
  description?: string;
  /** Wariant nagłówka; domyślnie `home` na `/`, `page` na pozostałych stronach. */
  header?: 'home' | 'page';
  /** Aktywna sekcja nagłówka; strony usług przekazują `kompetencje`. */
  activeSection?: 'kompetencje';
}

const { title, description, activeSection } = Astro.props;
const header = Astro.props.header ?? (Astro.url.pathname === '/' ? 'home' : 'page');
---

<!doctype html>
<html lang="pl" data-layout="base">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} />
    <link
      rel="preload"
      href="/fonts/inter-latin-800-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <SkipLink target="tresc" />
    <SiteHeader variant={header} activeSection={activeSection} />
    <main id="tresc" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }
  main {
    flex: 1;
  }
  main:focus {
    outline: none;
  }
</style>
