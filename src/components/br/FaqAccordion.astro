---
// FAQ: D/Projekty-BR.dc.html:208-227 (układ) i 288-318 (pytania, stan: pierwszy otwarty, kliknięcie
// otwartego zamyka, otwarcie innego zamyka poprzedni). Wzorzec akordeonu WAI-ARIA APG: przycisk w
// h3 z aria-expanded i aria-controls, panel z role="region" i aria-labelledby. Enter i Spacja
// działają natywnie na <button>. Skrypt jest plikiem w /_astro/ (CSP script-src 'self').
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  items: FaqItem[];
}

const { id, eyebrow, heading, items } = Astro.props;
---

<section class="faq" data-component="faq-accordion">
  <div class="faq__inner">
    <SectionHeading eyebrow={eyebrow} title={heading} align="left" />
    <div class="faq__list" data-faq>
      {items.map((item, index) => {
        const open = index === 0;
        const buttonId = `${id}-q${index + 1}`;
        const panelId = `${id}-a${index + 1}`;
        return (
          <div class="faq__item">
            <h3 class="faq__question">
              <button
                type="button"
                class="faq__button"
                id={buttonId}
                aria-expanded={open ? 'true' : 'false'}
                aria-controls={panelId}
                data-faq-button
              >
                <span>{item.q}</span>
                <span class="faq__chevron">
                  <Icon name="chevron-down" size={20} />
                </span>
              </button>
            </h3>
            <div
              class="faq__panel"
              id={panelId}
              role="region"
              aria-labelledby={buttonId}
              hidden={!open}
            >
              <p>{item.a}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Jeden otwarty naraz; kliknięcie otwartego pytania je zamyka (D/Projekty-BR.dc.html:316).
  for (const list of document.querySelectorAll<HTMLElement>('[data-faq]')) {
    const buttons = [...list.querySelectorAll<HTMLButtonElement>('[data-faq-button]')];
    const setOpen = (button: HTMLButtonElement, open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !open;
    };
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const willOpen = button.getAttribute('aria-expanded') !== 'true';
        for (const other of buttons) setOpen(other, false);
        if (willOpen) setOpen(button, true);
      });
    }
  }
</script>

<style>
  .faq {
    padding: var(--space-20) var(--container-pad);
    background: var(--surface-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .faq__inner {
    max-width: var(--x-container-faq);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .faq__item {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    overflow: hidden;
  }
  .faq__question {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }
  .faq__button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .faq__button:hover {
    background: var(--green-50);
  }
  .faq__button:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: -3px;
  }
  .faq__chevron {
    display: inline-flex;
    flex: none;
    color: var(--green-700);
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .faq__button[aria-expanded='true'] .faq__chevron {
    transform: rotate(180deg);
  }
  .faq__panel p {
    margin: 0;
    padding: 0 var(--space-6) var(--space-6);
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__button,
    .faq__chevron {
      transition: none;
    }
  }
</style>
