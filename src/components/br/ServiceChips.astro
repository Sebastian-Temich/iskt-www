---
// „Pozostałe kompetencje” jako chipy: D/Projekty-BR.dc.html:242-253. Design linkuje każdy chip do
// #kompetencje strony głównej; tu każdy prowadzi do strony usługi z W-01 (Szkolenia: link zewnętrzny).
export interface Chip {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  heading?: string;
  items: Chip[];
}

const { heading = 'Pozostałe kompetencje', items } = Astro.props;
---

<section class="chips" data-component="service-chips">
  <div class="chips__inner">
    <h2>{heading}</h2>
    <ul class="chips__list">
      {items.map((chip) => (
        <li>
          <a
            class="chips__chip"
            href={chip.href}
            {...(chip.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {chip.label}
            {chip.external && <span class="chips__hidden"> (otwiera się w nowej karcie)</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .chips {
    padding: var(--space-16) var(--container-pad);
    background: var(--surface-page);
  }
  .chips__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  h2 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--fw-extrabold);
    letter-spacing: var(--ls-tight);
  }
  .chips__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips__chip {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    background: var(--surface-card);
  }
  .chips__chip:hover {
    color: var(--text-link-hover);
    border-color: var(--green-500);
  }
  .chips__hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
