---
// Etykieta DS (DS/_ds_bundle.js:111): pigułka w tonie miękkim albo pełnym.
type Tone = 'green' | 'lime' | 'neutral' | 'success' | 'warning' | 'error' | 'info';

interface Props {
  tone?: Tone;
  soft?: boolean;
  class?: string;
}

const { tone = 'green', soft = true, class: className } = Astro.props;
---

<span
  class:list={[
    'badge',
    'text-meta',
    `badge--${tone}`,
    soft ? 'badge--soft' : 'badge--solid',
    className,
  ]}
>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wide);
    line-height: 1.4;
    white-space: nowrap;
  }
  .badge--solid {
    color: #fff;
  }
  .badge--green.badge--solid {
    background: var(--green-700);
  }
  .badge--green.badge--soft {
    color: var(--green-800);
    background: var(--green-100);
  }
  .badge--lime.badge--solid {
    background: var(--green-500);
  }
  .badge--lime.badge--soft {
    color: var(--green-800);
    background: var(--green-50);
  }
  .badge--neutral.badge--solid {
    background: var(--neutral-700);
  }
  .badge--neutral.badge--soft {
    color: var(--neutral-700);
    background: var(--neutral-200);
  }
  .badge--success.badge--solid {
    background: var(--success-500);
  }
  .badge--success.badge--soft {
    color: var(--success-500);
    background: var(--success-50);
  }
  .badge--warning.badge--solid {
    background: var(--warning-500);
  }
  .badge--warning.badge--soft {
    color: #8a6408;
    background: var(--warning-50);
  }
  .badge--error.badge--solid {
    background: var(--error-500);
  }
  .badge--error.badge--soft {
    color: var(--error-500);
    background: var(--error-50);
  }
  .badge--info.badge--solid {
    background: var(--info-500);
  }
  .badge--info.badge--soft {
    color: var(--info-500);
    background: var(--info-50);
  }
</style>
