---
// Tabela porównawcza: D/ESG.dc.html:128-173 (h2, opis, tabela 4 kolumny z min. 720 px). Tabela
// przewija się poziomo w kontenerze z tabindex=0 (dostęp z klawiatury) i nazwą z podpisu <caption>
// (architektura, „Punkty przełamania”; W-03, W-11). Pierwsza kolumna to nagłówki wierszy.
interface Props {
  heading: string;
  intro: string;
  /** Podpis tabeli: nazwa przewijanego regionu dla czytnika ekranu. */
  caption: string;
  columns: string[];
  /** Wiersze: pierwsza komórka to nagłówek wiersza (pogrubiony), reszta to dane. */
  rows: string[][];
  /** Identyfikator podpisu; unikalny na stronie. */
  id?: string;
}

const { heading, intro, caption, columns, rows, id = 'porownanie' } = Astro.props;
const captionId = `${id}-podpis`;
---

<section class="comparison" data-component="comparison-table">
  <div class="comparison__inner">
    <div class="comparison__head">
      <h2 class="comparison__heading">{heading}</h2>
      <p class="comparison__intro">{intro}</p>
    </div>
    <div
      class="comparison__scroll"
      data-scroll
      tabindex="0"
      role="region"
      aria-labelledby={captionId}
    >
      <table>
        <caption id={captionId} class="comparison__caption">
          {caption}
        </caption>
        <thead>
          <tr>
            {columns.map((column) => (
              <th scope="col" class="text-meta">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map(([first, ...cells]) => (
            <tr>
              <th scope="row">{first}</th>
              {cells.map((cell) => (
                <td>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison {
    padding: var(--space-20) var(--container-pad);
    background: var(--surface-page);
  }
  .comparison__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .comparison__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 720px;
  }
  .comparison__heading {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--fw-extrabold);
    letter-spacing: var(--ls-tight);
  }
  .comparison__intro {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .comparison__scroll {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
  }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  /* Komórki to tekst podstawowy (W-03: ≥ 16 px na mobile); nagłówki kolumn zostają text-meta. */
  tbody th,
  td {
    font-size: var(--text-base);
  }
  .comparison__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  th,
  td {
    padding: var(--space-4) var(--space-5);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border-subtle);
  }
  thead tr {
    background: var(--surface-subtle);
  }
  thead th {
    font-weight: var(--fw-bold);
  }
  tbody th {
    font-weight: var(--fw-semibold);
  }
  td {
    color: var(--text-secondary);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
