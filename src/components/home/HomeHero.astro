---
// Hero strony głównej: D/ISKT-standalone.dc.html:54-86. Nagłówek z logo i „Umów konsultację”
// renderuje SiteHeader (wariant home) poza <main>; tu zostaje treść hero pod nim.
import { Picture } from 'astro:assets';
import logo from '../../assets/iskt-logo.png';
import { company } from '../../content/site';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

// Logo to element LCP na mobile (QA M1, #22). Szerokość na ekranie = min(320px, 78% kolumny):
// - jedna kolumna (< 712 px): kolumna = 100vw − 2 × --container-pad;
// - dwie kolumny (od 712 px, gdy wnętrze ≥ 2 × 300 px + --space-10): kolumna = połowa wnętrza bez
//   odstępu, wnętrze najwyżej --container-max (1200 px), więc od ~1300 px logo ma zawsze 320 px.
// Zmiana paddingu, odstępu albo siatki w .hero__inner wymaga aktualizacji `sizes`.
const pad = 'clamp(1.25rem, 5vw, 3rem)';
const sizes = [
  `(min-width: 712px) min(320px, calc((100vw - 2 * ${pad} - 2.5rem) * 0.39))`,
  `min(320px, calc((100vw - 2 * ${pad}) * 0.78))`,
].join(', ');
// Drabinka co 20 px (240–640): najbliższy większy kandydat jest najwyżej ~8% szerszy niż miejsce na
// ekranie, więc nadmiar w audycie uses-responsive-images < 10 KiB przy każdym DPR (test e2e QA-M1-1).
const widths = Array.from({ length: 21 }, (_, i) => 240 + i * 20);
---

<section id="top" class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__inner">
    <div class="hero__copy">
      <Badge tone="lime">{company.slogan}</Badge>
      <h1 class="hero__title">
        Technologie przyszłości dla <span class="hero__accent">odpowiedzialnego biznesu</span>
      </h1>
      <p class="hero__lead">
        ISKT Greennovation to zespół ekspertów łączących pasję do innowacji technologicznych.
        Wspieramy organizacje w transformacji cyfrowej, wdrażaniu rozwiązań AI i strategiach ESG.
      </p>
      <div class="hero__actions">
        <Button href="#kontakt" size="lg" iconRight="arrow-right">
          Umów rozmowę
        </Button>
        <Button href="#kompetencje" size="lg" variant="outline">
          Zobacz kompetencje
        </Button>
      </div>
    </div>
    <div class="hero__visual">
      <Picture
        src={logo}
        alt=""
        width={320}
        widths={widths}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="hero__logo"
        pictureAttributes={{ class: 'hero__picture' }}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--space-16) var(--container-pad) var(--space-20);
    background: var(--gradient-wash);
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero__glow {
    position: absolute;
    top: -30%;
    left: -10%;
    width: 640px;
    height: 640px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(84, 132, 29, 0.16), transparent 62%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-10);
    align-items: center;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
  }
  .hero__title {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: var(--fw-extrabold);
    letter-spacing: var(--ls-tighter);
    line-height: 1.04;
    text-wrap: balance;
  }
  .hero__accent {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    margin: 0;
    max-width: 520px;
    font-size: var(--text-lg);
    line-height: var(--lh-relaxed);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero__visual {
    display: flex;
    justify-content: center;
  }
  /* <picture> bez własnego pudełka: <img> zostaje elementem flex jak przed zmianą na Picture. */
  .hero__visual :global(.hero__picture) {
    display: contents;
  }
  .hero__visual :global(.hero__logo) {
    width: min(320px, 78%);
    height: auto;
    filter: drop-shadow(0 16px 40px rgba(30, 85, 29, 0.22));
  }

  @media (max-width: 480px) {
    .hero__actions {
      width: 100%;
    }
    .hero__actions :global(.btn) {
      width: 100%;
      white-space: normal;
    }
  }
</style>
