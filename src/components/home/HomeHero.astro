---
// Hero strony głównej: D/ISKT-standalone.dc.html:54-86. Nagłówek z logo i „Umów konsultację”
// renderuje SiteHeader (wariant home) poza <main>; tu zostaje treść hero pod nim.
import { getImage } from 'astro:assets';
import logo from '../../assets/iskt-logo.png';
import { company } from '../../content/site';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

// Logo w hero tylko od 768 px (#43): poniżej CSS ukrywa .hero__visual, a pierwsze <source> z media
// < 768 px wskazuje przezroczysty piksel w data: (CSP img-src 'self' data:), więc telefon nie pobiera
// pliku logo. <picture> składany ręcznie z getImage, bo <Picture> nie przyjmuje własnego <source>.
const MOBILE_MEDIA = '(max-width: 767.98px)';
const EMPTY_PIXEL =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
// Szerokość na ekranie = min(320px, 78% kolumny). Od 768 px hero ma dwie kolumny (od 712 px, gdy
// wnętrze ≥ 2 × 300 px + --space-10): kolumna = połowa wnętrza bez odstępu, wnętrze najwyżej
// --container-max (1200 px), więc od ~1300 px logo ma zawsze 320 px.
// Zmiana paddingu, odstępu albo siatki w .hero__inner wymaga aktualizacji `sizes`.
const pad = 'clamp(1.25rem, 5vw, 3rem)';
const sizes = `min(320px, calc((100vw - 2 * ${pad} - 2.5rem) * 0.39))`;
// Drabinka co 20 px (240–640): najbliższy większy kandydat jest najwyżej ~8% szerszy niż miejsce na
// ekranie, więc nadmiar w audycie uses-responsive-images < 10 KiB przy każdym DPR (test e2e QA-M1-1).
const widths = Array.from({ length: 21 }, (_, i) => 240 + i * 20);
const [avif, webp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) =>
    getImage({ src: logo, width: 320, widths, sizes, format }),
  ),
);
---

<section id="top" class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__inner">
    <div class="hero__copy">
      <Badge tone="lime">{company.slogan}</Badge>
      <h1 class="hero__title">
        Technologie przyszłości dla <span class="hero__accent">odpowiedzialnego biznesu</span>
      </h1>
      <p class="hero__lead">
        ISKT Greennovation to zespół ekspertów łączących pasję do innowacji technologicznych.
        Wspieramy organizacje w transformacji cyfrowej, wdrażaniu rozwiązań AI i strategiach ESG.
      </p>
      <div class="hero__actions">
        <Button href="#kontakt" size="lg" iconRight="arrow-right">
          Umów rozmowę
        </Button>
        <Button href="#kompetencje" size="lg" variant="outline">
          Zobacz kompetencje
        </Button>
      </div>
    </div>
    <div class="hero__visual">
      <picture class="hero__picture">
        <source media={MOBILE_MEDIA} srcset={EMPTY_PIXEL} />
        <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
        <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
        <img
          src={webp.src}
          srcset={webp.srcSet.attribute}
          sizes={sizes}
          width={webp.attributes.width}
          height={webp.attributes.height}
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="hero__logo"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* Nad treścią nagłówek home (SiteHeader, nałożony absolutnie): jak we wzorcu l. 54-66
       padding --space-10, rząd nagłówka i odstęp --space-16 do siatki hero. */
    padding: calc(var(--space-10) + var(--site-header-home-h, 40px) + var(--space-16))
      var(--container-pad) var(--space-20);
    background: var(--gradient-wash);
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero__glow {
    position: absolute;
    top: -30%;
    left: -10%;
    width: 640px;
    height: 640px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(84, 132, 29, 0.16), transparent 62%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-10);
    align-items: center;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
  }
  .hero__title {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: var(--fw-extrabold);
    letter-spacing: var(--ls-tighter);
    line-height: 1.04;
    text-wrap: balance;
  }
  .hero__accent {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    margin: 0;
    max-width: 520px;
    font-size: var(--text-lg);
    line-height: var(--lh-relaxed);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero__visual {
    display: flex;
    justify-content: center;
  }
  /* <picture> bez własnego pudełka: <img> zostaje elementem flex jak przed zmianą na Picture. */
  .hero__visual :global(.hero__picture) {
    display: contents;
  }
  .hero__visual :global(.hero__logo) {
    width: min(320px, 78%);
    height: auto;
    filter: drop-shadow(0 16px 40px rgba(30, 85, 29, 0.22));
  }

  /* Telefon: bez dużego logo (#43). Próg zgodny z MOBILE_MEDIA w <source>. Przyciski hero przy
     < 480 px mają szerokość treści jak we wzorcu D/ISKT-standalone.dc.html (bez rozciągania). */
  @media (max-width: 767.98px) {
    .hero__visual {
      display: none;
    }
  }
</style>
