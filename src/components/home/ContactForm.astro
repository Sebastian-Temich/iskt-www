---
// Formularz kontaktowy w wersji statycznej: D/ISKT-standalone.dc.html:165-180 (Card lg, pola DS
// Input/Textarea, przycisk „Wyślij wiadomość”). Wysyłka, stany i klauzula dochodzą w T6; tu formularz
// nie ma `action` i nie wysyła danych. Bez JavaScriptu formularz jest ukryty (`hidden`), a `<noscript>`
// podaje kontakt (architektura, „Bezpieczeństwo”); skrypt odkrywa go dopiero po podpięciu obsługi.
import { company } from '../../content/site';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Field from '../ui/Field.astro';
---

<Card padding="lg" class="contact-form">
  <form class="contact-form__form" method="post" hidden data-contact-form>
    <Field
      label="Imię i nazwisko"
      name="name"
      placeholder="Jan Kowalski"
      autocomplete="name"
      required
    />
    <Field
      label="E-mail"
      name="email"
      type="email"
      placeholder="jan@firma.pl"
      autocomplete="email"
      required
    />
    <Field
      label="Wiadomość"
      name="message"
      type="textarea"
      rows={3}
      placeholder="Opisz swój projekt…"
      required
    />
    <Button type="submit" size="lg" fullWidth iconRight="send">
      Wyślij wiadomość
    </Button>
  </form>
  <noscript>
    <p class="contact-form__noscript" data-testid="contact-noscript">
      Aby wysłać formularz, włącz JavaScript albo napisz do nas:
      <a href={`mailto:${company.email}`}>{company.email}</a>
      lub zadzwoń: <a href={company.phoneHref}>{company.phone}</a>.
    </p>
  </noscript>
</Card>

<script>
  // Do T6 (wysyłka przez fetch) formularz niczego nie wysyła. Odkrywamy go dopiero po podpięciu
  // blokady, więc bez JS nie da się go wysłać natywnie.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    form.addEventListener('submit', (event) => event.preventDefault());
    form.hidden = false;
  }
</script>

<style>
  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-form__form[hidden] {
    display: none;
  }
  .contact-form__noscript {
    margin: 0;
    color: var(--text-primary);
    line-height: var(--lh-relaxed);
  }
</style>
