---
// Jedna stopka wszystkich stron: pełna wersja z D/ESG.dc.html:247-252, dane z content/site.ts,
// rok z daty buildu. Link do polityki prywatności (W-06) na wszystkich stronach.
import { company } from '../../content/site';

const privacyPath = '/polityka-prywatnosci/';

const year = new Date().getFullYear();
const { street, postalCode, city } = company.address;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__legal text-meta">
      © {year}
      {company.name} · {street}, {postalCode}
      {city} · NIP {company.nip}
    </p>
    <p class="site-footer__contact">
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={company.phoneHref}>{company.phone}</a>
      <span>{company.domain}</span>
      <a href={privacyPath}>Polityka prywatności</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-8) var(--container-pad);
    background: var(--ink-900);
    color: var(--neutral-300);
  }
  .site-footer__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .site-footer__legal {
    margin: 0;
    font-size: var(--text-xs);
  }
  .site-footer__contact {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    /* Tekst podstawowy ≥ 16 px na mobile (W-03); w designie 12 px. */
    font-size: var(--text-base);
    color: var(--green-300);
  }
  /* Obszar kliknięcia ≥ 24×24 px (W-03). */
  .site-footer__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--green-300);
  }
  .site-footer__contact a:hover {
    color: var(--green-200);
  }
</style>
