# Wzór pliku .env.local. Tylko nazwy, bez wartości.
# .env.local zawiera wyłącznie klucze testowe. Kluczy produkcyjnych tu nie ma.
# Projekt bez bazy danych (ADR-002): bez zmiennych Supabase.

# Adres i środowisko serwisu (domyślnie: staging z noindex; adres z VERCEL_PROJECT_PRODUCTION_URL albo localhost)
PUBLIC_SITE_URL=
PUBLIC_SITE_ENV=

# Resend (ADR-004): w dev i na stagingu tylko klucz testowy
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Wysyłka w testach: mock (bez prawdziwych e-maili)
MAIL_TRANSPORT=

# Rate limit formularza (ADR-003): waf (domyślnie) albo upstash
RATE_LIMIT_PROVIDER=
RATE_LIMIT_SALT=
