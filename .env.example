# Wzór pliku .env.local. Tylko nazwy, bez wartości.
# .env.local zawiera wyłącznie klucze testowe. Kluczy produkcyjnych tu nie ma.
# Projekt bez bazy danych (ADR-002): bez zmiennych Supabase.

# Adres i środowisko serwisu (domyślnie: staging z noindex; adres z VERCEL_PROJECT_PRODUCTION_URL albo localhost)
PUBLIC_SITE_URL=
PUBLIC_SITE_ENV=

# Resend (ADR-004): w dev i na stagingu tylko klucz testowy
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Wysyłka w testach: mock (bez prawdziwych e-maili)
MAIL_TRANSPORT=

# Rate limit formularza (ADR-003): waf (domyślnie) albo upstash
RATE_LIMIT_PROVIDER=
RATE_LIMIT_SALT=

# Upstash Redis REST (tylko przy RATE_LIMIT_PROVIDER=upstash, fallback ADR-003)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tylko build E2E (playwright.config.ts): node = adapter Node dla astro preview. Na Vercel nie ustawiać.
ASTRO_ADAPTER=

# Lighthouse (lighthouserc.cjs, pnpm lh:staging), wszystkie opcjonalne:
# LH_BASE_URL adres bazowy (domyślnie http://localhost:55327; pierwszy argument skryptu ma pierwszeństwo),
# LH_PRESET mobile albo desktop (domyślnie mobile), LH_ENV production wyłącza pominięcie is-crawlable
# (domyślnie staging), LH_RUNS liczba przebiegów na stronę (domyślnie 3), CHROME_PATH własny Chrome
# (domyślnie Chrome z Playwright)
LH_BASE_URL=
LH_PRESET=
LH_ENV=
LH_RUNS=
CHROME_PATH=
